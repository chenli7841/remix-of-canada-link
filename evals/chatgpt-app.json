{
  "version": 1,
  "name": "EPLUS ChatGPT App regression suite",
  "cases": [
    {
      "id": "identity-direct",
      "role": "customer",
      "prompt": "确认我现在连接的是哪个 EPLUS 客户账号。",
      "expected_tools": ["get_current_customer"],
      "must_include": ["customer_code"],
      "must_not_include": ["其他客户"]
    },
    {
      "id": "orders-direct",
      "role": "customer",
      "prompt": "查看我最近 5 个订单。",
      "expected_tools": ["list_my_orders"],
      "must_include": ["CAD"],
      "must_not_include": ["CNY", "人民币", "元"]
    },
    {
      "id": "orders-indirect",
      "role": "customer",
      "prompt": "我最近买的东西处理到哪里了？",
      "expected_tools": ["list_my_orders"],
