# Public/browser-safe Supabase configuration. Copy to .env locally and fill values there.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Public ChatGPT account setup origin. Change this when the website domain changes.
MCP_PUBLIC_SITE_URL=https://china-to-canada-connect.lovable.app

# Server-only secrets belong in Lovable/Supabase Secrets, never in a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=

# EPLUS群发通知 (WeCom customer-group broadcast, standalone app AgentId 1000005).
# Fully independent from the WeCom AI customer-service app above — separate
# CorpID/Secret, never shared. Test-domain only for now; keep WECOM_ENABLED
# unset/false until WeCom app authorization and trusted egress IP allowlisting
# have been verified. When false, group sync and real sending are both refused;
# only binding management and local send-preview work.
# WECOM_NOTIFY_CORP_ID=
# WECOM_NOTIFY_AGENT_ID=1000005
# WECOM_NOTIFY_SECRET=
# WECOM_ENABLED=false
